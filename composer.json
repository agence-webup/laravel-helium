{
    "name": "webup/laravel-helium",
    "description": "Laravel package for agence-webup/helium.",
    "license": "MIT",
    "authors": [
        {
            "name": "Baptiste Ducatel",
            "email": "baptiste@agence-webup.com"
        },
        {
            "name": "Bryan Levieux",
            "email": "bryan@agence-webup.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^8.37|^9.0|^10.0|^11.0|^12.0|^13.0",
        "anlutro/l4-settings": "^1.3|^1.4",
        "webup/laravel-form": "^1.3|^1.11",
        "yajra/laravel-datatables-oracle": "^10|^11|^12|^13",
        "laravel/ui": "^2.0|^3.0|^4.0",
        "laravel/helpers": "^1.7",
        "spatie/laravel-permission": "^5|^6|^7|^8"
    },
    "autoload": {
        "psr-4": {
            "Webup\\LaravelHelium\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webup\\LaravelHelium\\Core\\CoreServiceProvider"
            ],
            "aliases": {
                "Helium": "Webup\\LaravelHelium\\Core\\Facades\\Helium"
            }
        }
    },
    "minimum-stability": "dev"
}
